{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git check-ignore:*)",
      "Bash(gh auth:*)",
      "Bash(gh repo view:*)",
      "Bash(gh pr:*)",
      "Read(./**)",
      "Bash(pnpm install:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm --filter:*)",
      "Bash(pnpm exec prettier:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose up:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(secrets/**)",
      "Read(**/.env)",
      "Read(**/secrets/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(secrets/**)",
      "Bash(git push --force:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(rm -rf:*)",
      "Bash(pnpm publish:*)",
      "Bash(npm publish:*)",
      "Bash(docker compose down -v:*)",
      "Bash(pnpm exec prisma migrate reset:*)",
      "Bash(npx prisma migrate reset:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); [ -n \"$f\" ] && \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-format.sh\" \"$f\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); [ -n \"$f\" ] && \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-typescript.sh\" \"$f\"; exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "c=$(jq -r '.tool_input.command // empty'); case \"$c\" in *\"git commit\"*) \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-security.sh\";; esac"
          }
        ]
      }
    ]
  }
}
