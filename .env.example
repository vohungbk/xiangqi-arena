# ---------- Docker Compose ----------
POSTGRES_USER=xiangqi
POSTGRES_PASSWORD=xiangqi_dev_password
POSTGRES_DB=xiangqi_arena
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---------- Server (apps/server) ----------
NODE_ENV=development
SERVER_PORT=4000
# Comma-separated list. The WS handshake validates the Origin header against this list.
ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://xiangqi:xiangqi_dev_password@localhost:5432/xiangqi_arena?schema=public
REDIS_URL=redis://localhost:6379

# Auth (OAuth 2.0 PKCE + Email OTP)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
EMAIL_OTP_TTL_SECONDS=300
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@xiangqi-arena.local

# ---------- Web (apps/web) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
