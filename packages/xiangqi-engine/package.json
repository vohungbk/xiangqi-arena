{
  "name": "@xiangqi/xiangqi-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Pure Xiangqi rules engine. Runs in Node with no browser, network or database.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@xiangqi/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.2",
    "@xiangqi/config-eslint": "workspace:*",
    "@xiangqi/config-typescript": "workspace:*",
    "@xiangqi/config-vitest": "workspace:*",
    "eslint": "^8.57.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
